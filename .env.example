# ============================================================
# ResearchMind AI – Environment Variables (EXAMPLE TEMPLATE)
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_NAME=ResearchMind AI
APP_ENV=development
DEBUG=true

# A strong random secret key for the application (used for signing, etc.)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# The URL where the backend is served (used in emails, links, etc.)
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------
# Google Gemini API
# Get your key at: https://aistudio.google.com/apikey
# Required for: Planner Agent, Analyst Agent, Fact Checker, Report Writer
# ------------------------------------------------------------
GEMINI_API_KEY=

# Model to use. Recommended: gemini-2.0-flash (fast) or gemini-1.5-pro (more capable)
# See all models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------
# Tavily Search API
# Get your key at: https://tavily.com
# Required for: Researcher Agent (web search)
# ------------------------------------------------------------
TAVILY_API_KEY=

# ------------------------------------------------------------
# PostgreSQL Database
# Install locally: https://www.postgresql.org/download/
# Or use Docker (see docker-compose.yml)
# Required for: User accounts, research history, reports
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/researchmind

# ------------------------------------------------------------
# Qdrant Vector Database
# Install locally or use Docker (see docker-compose.yml)
# Cloud option: https://qdrant.tech/documentation/cloud/
# Required for: RAG document search
# ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Leave empty for local unauthenticated Qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=researchmind_documents

# ------------------------------------------------------------
# Hugging Face – Sentence Embeddings
# No API key needed for public models.
# For gated/private models, create a token at: https://huggingface.co/settings/tokens
# Required for: Document embeddings in RAG pipeline
# ------------------------------------------------------------
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: only needed for private/gated models
HF_TOKEN=

# ------------------------------------------------------------
# JWT Authentication
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# LangSmith Tracing (Optional)
# Sign up at: https://smith.langchain.com/
# Used for: LLM call tracing, agent monitoring, latency analysis
# Set LANGCHAIN_TRACING_V2=true to enable
# ------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=researchmind-ai

# ------------------------------------------------------------
# Langfuse Tracing (Optional alternative to LangSmith)
# Sign up at: https://langfuse.com/
# ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------
# Email Notifications (Optional)
# Required for: Password reset, research completion notifications
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@researchmind.ai

# ------------------------------------------------------------
# Frontend Configuration
# IMPORTANT: Only put values safe to expose publicly here.
# Never put secret API keys in VITE_ variables – they are bundled into the browser.
# ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------
# Optional Future Services (Redis, S3 – not required initially)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=local
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------
# File Upload Limits
# ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_DOCUMENT_TYPES=pdf,txt,md,docx
